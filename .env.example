# Copy to .env and adjust. Never commit .env.

# Postgres (application database + Airflow metadata database on the same server)
POSTGRES_USER=dsp
POSTGRES_PASSWORD=changeme
POSTGRES_DB=dsp_app
POSTGRES_PORT=5432
AIRFLOW_DB=airflow

# Airflow
# Linux: set to the output of `id -u` so Airflow can write into ./data. Windows/macOS: keep 50000.
AIRFLOW_UID=50000
# Any long random string (e.g. `python -c "import secrets; print(secrets.token_hex(32))"`)
AIRFLOW_JWT_SECRET=replace-with-a-long-random-string

# Teams webhook of the "Data Quality Alerts" channel (Workflows: "Post to a channel when a
# webhook request is received"). Empty = alerts are only printed in the task logs.
TEAMS_WEBHOOK_DATA_QUALITY=

# Base URL used to build clickable Data Docs links in alerts (Defense 2: nginx).
# Empty = the alert shows the report path only.
DATA_DOCS_BASE_URL=
